                "cvss": {
                  "score": 2.1,
                  "vector": "CVSS:4.0/AV:N/AC:H/AT:N/PR:N/UI:A/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N"
                }
              }
            },
            {
              "id": "AUD-012",
              "name": "AUD012",
              "shortDescription": {
                "text": "CORS libera permanentemente as origens localhost/capacitor com credenciais, inclusive em produção"
              },
              "fullDescription": {
                "text": "Se um software local malicioso (ou um servidor de desenvolvimento de outro projeto na porta 80/443) abrir uma página em localhost, o navegador permitiria ler respostas da API — mas só se o cookie fosse enviado, o que SameSite=Lax bloqueia. O risco real hoje é residual; fica registrado porque o app Android (Capacitor) foi descontinuado e a exceção perdeu a razão de existir."
              },
              "help": {
                "text": "Incluir as origens de desenvolvimento apenas quando `!env.isProduction`; remover `capacitor://localhost`/`https://localhost` já que o APK foi retirado."
              },
              "properties": {
