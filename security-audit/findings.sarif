                }
              }
            },
            {
              "id": "AUD-014",
              "name": "AUD014",
              "shortDescription": {
                "text": "Política de senha abaixo do recomendado (mínimo de 6 caracteres, sem bloqueio de senhas vazadas)"
              },
              "fullDescription": {
                "text": "Com AUD-003 (limite por IP quebrado) e AUD-010 (enumeração), senhas curtas e comuns são o caminho mais barato para invadir contas; o hash forte só protege se a senha não for trivial."
              },
              "help": {
