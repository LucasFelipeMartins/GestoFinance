# Used only by `npm run build:app` (the Capacitor/Android build).
# The packaged app has no dev proxy and isn't served from the same origin
# as the API, so it needs the full production URL here.
# Replace with your actual Vercel deployment URL once you have it, e.g.:
# VITE_API_URL=https://gesto-finance.vercel.app/api
VITE_API_URL=https://REPLACE-WITH-YOUR-VERCEL-DOMAIN.vercel.app/api
