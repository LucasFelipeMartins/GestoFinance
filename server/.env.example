PORT=4000
NODE_ENV=development
# Origens extras permitidas a chamar a API (separadas por vírgula). O próprio
# domínio do deploy e o Vite local (fora de produção) já são aceitos.
CLIENT_ORIGIN=

MONGO_URL=mongodb://lucasmartinsfelipe321_db_user:<senha>@ac-x3xhnlb-shard-00-00.ms9evqk.mongodb.net:27017,ac-x3xhnlb-shard-00-01.ms9evqk.mongodb.net:27017,ac-x3xhnlb-shard-00-02.ms9evqk.mongodb.net:27017/gestor?ssl=true&replicaSet=atlas-1ijhzc-shard-0&authSource=admin&appName=Cluster1

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

MAX_AVATAR_SIZE_MB=5

# Optional locally. Required in production on Vercel — without it, avatars
# fall back to local disk, which doesn't persist on serverless. Create a
# Blob store in the Vercel dashboard (Storage tab) to get this token; Vercel
# injects it automatically into the project's env vars when connected.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# E-mail (confirmação de cadastro e redefinição de senha)
# ---------------------------------------------------------------------------
# Escolha UM provedor. Sem nenhum configurado, em desenvolvimento o código /
# link é impresso no console do servidor (e mostrado na tela); em produção o
# cadastro e o "esqueci minha senha" respondem com erro pedindo configuração.
#
# Opção 1 — Resend (https://resend.com, plano gratuito, funciona na Vercel):
RESEND_API_KEY=
#
# Opção 2 — qualquer SMTP (Gmail com "senha de app", Brevo, Mailgun...):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true apenas para porta 465.
#
# Remetente exibido nas mensagens (opcional). Ex.: GestorPro <no-reply@seudominio.com>
MAIL_FROM=
#
# URL pública do site, usada nos links dos e-mails. Opcional: sem ela o link é
# montado a partir do próprio pedido (funciona na Vercel, inclusive previews).
APP_URL=

# ---------------------------------------------------------------------------
# Assinatura (Mercado Pago — Pix, cartão e boleto)
# ---------------------------------------------------------------------------
# Enquanto MP_ACCESS_TOKEN estiver vazio ninguém é bloqueado (modo "tudo
# liberado"). Com ele definido: 7 dias grátis e depois R$ 11,90 a cada 30 dias.
MP_ACCESS_TOKEN=
# "Public Key" do MESMO conjunto de credenciais (teste ou produção): o formulário
# de cartão no navegador precisa dela. Pode ficar visível, não é segredo.
MP_PUBLIC_KEY=
# "Assinatura secreta" do webhook, mostrada no painel do Mercado Pago.
# Obrigatória em produção: sem ela as notificações são recusadas (401).
MP_WEBHOOK_SECRET=
# Só em desenvolvimento: e-mail do COMPRADOR de teste (painel do Mercado Pago →
# Contas de teste), exigido pelo sandbox para criar assinaturas de cartão.
MP_TEST_PAYER_EMAIL=
# Preço e período (opcionais — estes são os padrões).
PLAN_PRICE_BRL=11.90
PLAN_PERIOD_DAYS=30
TRIAL_DAYS=7
# Seus e-mails, separados por vírgula: nunca pagam e veem o painel de
# "Contas gratuitas" em Configurações para liberar outras pessoas.
ADMIN_EMAILS=
